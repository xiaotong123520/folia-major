# Replace with a unique random secret (at least 32 bytes); do not commit the real .env file.
MUSIC_BACKEND_API_KEY=replace-with-a-long-random-secret

# Optional public read-only API for GitHub Pages (CORS is not authentication).
MUSIC_PUBLIC_ORIGINS=

# Three supplied name-based point-song endpoints are enabled behind the PRIVATE gateway.
# The service tries:
#   QQ: api.lxink.cn -> cer.luckying.love/music/Lucky.php
#   NetEase: cer.luckying.love/music/LuckyWYY.php
# It accepts only actual audio responses or HTTPS audio URLs from allowlisted hosts.
# These external interfaces are unverified and cannot grant VIP/DRM access.
MUSIC_ENABLE_NAME_LOOKUP=true

# Optional additional multi-source providers:
# MUSIC_PRIMARY_BACKEND_URL in Compose is set internally to the private Go API.
MUSIC_METING_BASE_URL=
MUSIC_METING_TOKEN=
MUSIC_METING_PUBLIC_URL=
MUSIC_SEARCH_SOURCES=netease,qq,kugou,kuwo

# Do NOT set arbitrary domains, IP addresses or "localhost"; only your trusted media CDNs.
# Keep this narrow. Add the exact HTTPS media host found during authorized testing.
MUSIC_AUDIO_ALLOW_HOSTS=music.126.net,stream.qqmusic.qq.com,aqqmusic.tc.qq.com
