# Netease Cloud Music API Base URL
# If running the API locally, it might be http://localhost:3000
# If using a deployed instance, use the full URL
VITE_NETEASE_API_BASE=http://localhost:3000

# KuGouMusicApi Base URL (Web only, optional)
# Keep empty by default. Electron uses its bundled in-process KuGouMusicApi module.
# For development you may point this at a self-hosted or temporary debug instance.
VITE_KUGOU_API_BASE=

# qq-music-api Base URL (optional for Web and development builds)
# Electron packages and starts the embedded QQ Music API automatically.
# For Web or development builds, point this variable to a reachable QQ Music API instance,
# e.g. http://localhost:3200, to enable QQ Music sign-in and playlists.
VITE_QQ_API_BASE=

# Library development validation suite (optional, disabled by default)
# Set to true only to validate the TUI in development; production always disables it.
# Vitest and Playwright enable it automatically through their test configurations.
VITE_LIBRARY_TUI=false

# AI Provider
# Browser build configuration for existing AI features.
# Server deployments (Docker/Cloudflare) should set AI_PROVIDER to 'google'/'gemini' or 'openai'.
VITE_AI_PROVIDER=google
AI_PROVIDER=google

# Google Gemini API Key for server-side AI features (never use a VITE_ prefix).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override for the AI Radio backend.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Compatible API
# if you want to use OpenAI or other openai compatible APIs, like DeepSeek, Qwen, etc. set VITE_AI_PROVIDER=openai and set the following variables.
# OPENAI_API_URL accepts either a base URL (for example https://api.deepseek.com or https://api.openai.com/v1)
# or a full chat completions endpoint.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1
# The provider is inferred from the URL's host (OpenAI, DeepSeek, Kimi, GLM, Qwen, Tencent Cloud TokenHub,
# Xiaomi MiMo); any other host is treated as a generic compatible endpoint.
# OPENAI_API_MODEL is strongly recommended for compatible providers that require an explicit model name.
# Left blank, the provider's default model is used (for example deepseek-flash for api.deepseek.com,
# gpt-5.6-luna for OpenAI and unknown hosts), but setting it explicitly is clearer.
OPENAI_API_MODEL=gpt-4o
# Optional. Defaults to 0.7 when omitted or invalid. Only sent to providers that accept it, clamped to
# their range (never sent to OpenAI or Kimi; at most 1 for GLM, 1.5 for MiMo, 1.99 for Qwen).
OPENAI_API_TEMPERATURE=0.7

# Apple Music / MusicKit Web (optional)
# These are server-only credentials. Do NOT prefix them with VITE_.
# Create a MusicKit key in Apple Developer and keep the .p8 private key secret.
APPLE_MUSICKIT_TEAM_ID=
APPLE_MUSICKIT_KEY_ID=
# Paste the full .p8 key content; multiline or escaped \\n is supported.
APPLE_MUSICKIT_PRIVATE_KEY=

# Optional server music. Public URL only, no cookies or bearer secrets.
# Pages: configure the same repository Actions variable and rebuild.
VITE_MUSIC_BACKEND_BASE_URL=
# Vercel server-only gateway credentials (never VITE_ prefixed).
MUSIC_BACKEND_UPSTREAM_URL=
MUSIC_BACKEND_UPSTREAM_API_KEY=
FOLIA_ALLOWED_ORIGINS=

# Optional first-visit public catalog; explicit saved platform selections take precedence.
VITE_INITIAL_ONLINE_PROVIDER=
